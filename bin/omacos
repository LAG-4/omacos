#!/bin/zsh

set -euo pipefail

command_directory=${0:A:h}
installed_root=${OMACOS_ROOT:-${command_directory:h}}
omacos_home=${OMACOS_TEST_HOME:-$HOME}
launch_agent="$omacos_home/Library/LaunchAgents/dev.omacos.shell.plist"
shell_binary="$omacos_home/.local/bin/omacos-shell"

print_usage() {
  cat <<'EOF'
Usage: omacos <command>

Commands:
  doctor                    Check the OMacOS installation and permissions
  capture ACTION            Screenshot, record, OCR text, or inspect a color
  default ACTION            View or set terminal, browser, and editor defaults
  launch TARGET             Launch a default app, file manager, or web app
  agent ACTION              Refresh or inspect AI agent usage records
  media ACTION              Inspect or control Apple Music and Spotify
  weather ACTION            Show a forecast or configure its location
  toggle ACTION             Toggle stay-awake, bar, and shell indicators
  notice NAME               Show date/time, battery, or weather notice
  dictation ACTION          Start, stop, or toggle native dictation
  update ACTION             Check, apply, or roll back OMacOS updates
  backup ACTION             Snapshot or restore files managed by OMacOS
  migrate ACTION            Run or inspect versioned migrations
  notification ACTION       Add, list, clear, or open OMacOS notification history
  speedtest KIND            Measure network or disk performance
  network ACTION            Inspect Wi-Fi or reveal the sharing QR panel
  service NAME ACTION       Control optional Tailscale and Dropbox services
  package ACTION            Browse, install, or remove optional applications
  plugin ACTION             Inspect built-ins or manage out-of-process providers
  wm ACTION                 Manage AeroSpace, Rift, or yabai through one interface
  reminder ACTION           Add, list, or clear local reminders
  webapp ACTION             Install, list, or remove URL app bundles
  theme apply [name]        Generate configs from a semantic theme
  shell start               Start the native bar
  shell stop                Stop the native bar
  shell restart             Restart the native bar
  shell toggle-menu         Toggle the native command menu
  shell toggle-panel NAME   Toggle a native Quattro-style panel
  uninstall [--yes]         Restore backed-up config and remove OMacOS files
EOF
}

doctor_check() {
  local label=$1
  local result=$2

  if [[ $result == "ok" ]]; then
    print "[ok]   $label"
  else
    print "[fail] $label"
    return 1
  fi
}

run_doctor() {
  local failures=0
  local macos_major
  macos_major=$(sw_vers -productVersion | cut -d. -f1)

  doctor_check "Apple Silicon" "$([[ $(uname -m) == "arm64" ]] && print ok || print fail)" || (( failures += 1 ))
  if (( macos_major >= 26 )); then
    doctor_check "macOS 26 or newer" "ok" || (( failures += 1 ))
  else
    doctor_check "macOS 26 or newer" "fail" || (( failures += 1 ))
  fi
  doctor_check "Homebrew" "$(command -v brew >/dev/null 2>&1 && print ok || print fail)" || (( failures += 1 ))
  local window_manager_profile
  window_manager_profile=$("$installed_root/scripts/window-manager.zsh" profile)
  case $window_manager_profile in
    aerospace) doctor_check "AeroSpace CLI" "$(command -v aerospace >/dev/null 2>&1 && print ok || print fail)" || (( failures += 1 )) ;;
    rift) doctor_check "Rift CLI" "$(command -v rift-cli >/dev/null 2>&1 && print ok || print fail)" || (( failures += 1 )) ;;
    yabai) doctor_check "yabai CLI" "$(command -v yabai >/dev/null 2>&1 && print ok || print fail)" || (( failures += 1 )) ;;
  esac
  doctor_check "Bluetooth helper" "$(command -v blueutil >/dev/null 2>&1 && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Window manager profile ($window_manager_profile)" "$([[ -s $omacos_home/.config/omacos/window-manager-profile ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Karabiner rule installed" "$([[ -f $omacos_home/.config/karabiner/assets/complex_modifications/omacos-super-key.json ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Native shell binary" "$([[ -x $shell_binary ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Native shell app bundle" "$([[ -x $omacos_home/.local/share/omacos/OMacOSShell.app/Contents/MacOS/omacos-shell ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Shell LaunchAgent" "$([[ -f $launch_agent ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Application defaults" "$([[ -f $omacos_home/.config/omacos/defaults.json ]] && print ok || print fail)" || (( failures += 1 ))
  doctor_check "Shell integration" "$(rg -Fq '# >>> OMacOS shell integration >>>' "$omacos_home/.zshrc" 2>/dev/null && print ok || print fail)" || (( failures += 1 ))

  if (( failures > 0 )); then
    print -u2 "OMacOS doctor found $failures problem(s)."
    return 1
  fi

  print "OMacOS doctor found no installation problems."
}

run_shell_command() {
  local action=${1:-}

  case $action in
    start)
      if [[ ! -x $shell_binary ]]; then
        print -u2 "OMacOS shell is not installed at $shell_binary"
        return 1
      fi
      if [[ -f $launch_agent ]]; then
        launchctl bootstrap "gui/$UID" "$launch_agent" 2>/dev/null || true
      elif ! pgrep -x omacos-shell >/dev/null 2>&1; then
        "$shell_binary" >/dev/null 2>&1 &!
      fi
      ;;
    stop)
      if [[ -f $launch_agent ]]; then
        launchctl bootout "gui/$UID" "$launch_agent" >/dev/null 2>&1 || true
      fi
      pkill -x omacos-shell 2>/dev/null || true
      ;;
    restart)
      if [[ -f $launch_agent ]]; then
        launchctl bootout "gui/$UID" "$launch_agent" >/dev/null 2>&1 || true
      fi
      pkill -x omacos-shell 2>/dev/null || true
      if [[ -f $launch_agent ]]; then
        launchctl bootstrap "gui/$UID" "$launch_agent"
      else
        "$shell_binary" >/dev/null 2>&1 &!
      fi
      ;;
    toggle-menu)
      "$shell_binary" --toggle-menu
      ;;
    toggle-panel)
      local panel_name=${2:-}
      case $panel_name in
        menu|keybindings|clipboard|emojis|capture|reminders|notifications|themes|wallpapers|defaults|agents|weather|media|dictation|wifi-qr|speedtest|disk-speedtest|tailscale|dropbox|packages|plugins|notice-datetime|notice-battery|notice-weather|system|audio|bluetooth|network|display|clock|power|activity)
          "$shell_binary" --toggle-panel "$panel_name"
          ;;
        *)
          print -u2 "Unknown shell panel: $panel_name"
          print -u2 "Available panels: menu, keybindings, clipboard, emojis, capture, reminders, themes, wallpapers, defaults, agents, weather, media, system, audio, bluetooth, network, display, clock, power, activity"
          return 1
          ;;
      esac
      ;;
    *)
      print -u2 "Unknown shell action: $action"
      return 1
      ;;
  esac
}

parse_reminder_duration() {
  local duration=$1
  local amount
  local unit

  if [[ $duration != <->(s|m|h|d) ]]; then
    print -u2 "Invalid reminder duration: $duration (use 30s, 10m, 2h, or 1d)"
    return 1
  fi

  amount=${duration[1,-2]}
  unit=${duration[-1]}
  case $unit in
    s) print "$amount" ;;
    m) print "$(( amount * 60 ))" ;;
    h) print "$(( amount * 3600 ))" ;;
    d) print "$(( amount * 86400 ))" ;;
  esac
}

run_reminder_command() {
  local action=${1:-}

  if [[ ! -x $shell_binary ]]; then
    print -u2 "OMacOS shell is not installed at $shell_binary"
    return 1
  fi

  case $action in
    add)
      local duration=${2:-}
      local message=${3:-}
      if [[ -z $duration || -z $message ]]; then
        print -u2 "Usage: omacos reminder add DURATION MESSAGE"
        return 1
      fi
      local seconds
      seconds=$(parse_reminder_duration "$duration")
      "$shell_binary" --reminder-add "$seconds" "$message"
      ;;
    list|show)
      "$shell_binary" --reminder-list
      ;;
    clear)
      "$shell_binary" --reminder-clear
      ;;
    *)
      print -u2 "Usage: omacos reminder <add DURATION MESSAGE|list|clear>"
      return 1
      ;;
  esac
}

run_uninstall() {
  local uninstall_option=${1:-}
  local state_directory="$omacos_home/.local/state/omacos"
  local backup_directory="$state_directory/backups"
  local installed_directory="$omacos_home/.local/share/omacos"
  local stay_awake_agent="$omacos_home/Library/LaunchAgents/dev.omacos.stay-awake.plist"
  local assume_yes=false

  if [[ $uninstall_option == "--yes" || $uninstall_option == "-y" ]]; then
    assume_yes=true
  elif [[ -n $uninstall_option ]]; then
    print -u2 "Unknown uninstall option: $uninstall_option"
    return 1
  fi

  print "OMacOS will stop its shell, restore backed-up AeroSpace config, and remove its own files."
  if ! $assume_yes; then
    print -n "Continue? [y/N] "
    if ! read -r answer </dev/tty || [[ $answer != [yY] && $answer != [yY][eE][sS] ]]; then
      print "Uninstall cancelled."
      return 0
    fi
  fi

  pkill -x omacos-shell 2>/dev/null || true
  launchctl bootout "gui/$UID" "$launch_agent" >/dev/null 2>&1 || true
  launchctl bootout "gui/$UID" "$stay_awake_agent" >/dev/null 2>&1 || true

  if [[ -x $installed_root/scripts/shell-integration.zsh ]]; then
    "$installed_root/scripts/shell-integration.zsh" remove
  fi

  if [[ -x $installed_root/scripts/window-manager.zsh ]]; then
    "$installed_root/scripts/window-manager.zsh" restore
  fi

  if [[ -f $state_directory/had-xdg-aerospace-config ]]; then
    cp "$backup_directory/xdg-aerospace.toml" "$omacos_home/.config/aerospace/aerospace.toml"
  else
    rm -f "$omacos_home/.config/aerospace/aerospace.toml"
  fi

  if [[ -f $state_directory/had-dot-aerospace-config ]]; then
    cp "$backup_directory/dot-aerospace.toml" "$omacos_home/.aerospace.toml"
  else
    rm -f "$omacos_home/.aerospace.toml"
  fi

  rm -f "$omacos_home/.config/karabiner/assets/complex_modifications/omacos-super-key.json"
  rm -f "$omacos_home/.config/ghostty/themes/OMacOS"
  rm -f "$omacos_home/.local/bin/omacos" "$omacos_home/.local/bin/omacos-shell"
  rm -f "$launch_agent"
  rm -f "$stay_awake_agent"
  rm -rf "$omacos_home/Applications/OMacOS Web Apps"
  rm -rf "$omacos_home/.config/omacos" "$installed_directory"
  rm -rf "$state_directory"

  print "OMacOS files were removed. Homebrew packages were left installed."
}

case ${1:-help} in
  agent)
    case ${2:-} in
      usage-update|refresh) "$installed_root/bin/omacos-agent-usage-update" "${@:3}" ;;
      list) find "$omacos_home/.local/state/omacos/agents/usage" -maxdepth 1 -name '*.json' -print 2>/dev/null | sort ;;
      *) print -u2 "Usage: omacos agent <usage-update|list>"; exit 1 ;;
    esac
    ;;
  capture)
    "$installed_root/scripts/capture.zsh" "${2:-}" "${3:-}"
    ;;
  media)
    "$installed_root/scripts/media.zsh" "${2:-status}"
    ;;
  dictation)
    case ${2:-} in
      start|stop|toggle) "$shell_binary" --dictation "$2" ;;
      *) print -u2 'Usage: omacos dictation <start|stop|toggle>'; exit 1 ;;
    esac
    ;;
  update)
    "$installed_root/scripts/update.zsh" "${@:2}"
    ;;
  backup)
    "$installed_root/scripts/managed-snapshot.zsh" "${@:2}"
    ;;
  migrate)
    "$installed_root/scripts/migrations.zsh" "${@:2}"
    ;;
  notification)
    case ${2:-} in
      add)
        [[ -n ${3:-} && -n ${4:-} ]] || { print -u2 'Usage: omacos notification add TITLE BODY'; exit 1; }
        "$shell_binary" --notification-add "$3" "$4"
        ;;
      list) "$shell_binary" --notification-list ;;
      clear) "$shell_binary" --notification-clear ;;
      show) run_shell_command toggle-panel notifications ;;
      *) print -u2 'Usage: omacos notification <add TITLE BODY|list|clear|show>'; exit 1 ;;
    esac
    ;;
  speedtest)
    "$installed_root/scripts/speedtest.zsh" "${2:-}" "${3:-}"
    ;;
  network)
    if [[ ${2:-} == "wifi-qr" ]]; then
      run_shell_command toggle-panel wifi-qr
    else
      "$installed_root/scripts/network.zsh" "${2:-status}"
    fi
    ;;
  service)
    "$installed_root/scripts/services.zsh" "${@:2}"
    ;;
  package)
    "$installed_root/scripts/packages.zsh" "${@:2}"
    ;;
  plugin)
    if [[ ${2:-} == "show" ]]; then
      run_shell_command toggle-panel plugins
    else
      "$installed_root/scripts/plugins.zsh" "${@:2}"
    fi
    ;;
  wm|window-manager)
    "$installed_root/scripts/window-manager.zsh" "${@:2}"
    ;;
  weather)
    "$installed_root/scripts/weather.zsh" "${@:2}"
    ;;
  toggle)
    "$installed_root/scripts/toggles.zsh" "${@:2}"
    ;;
  notice)
    case ${2:-} in
      datetime|date|time) run_shell_command toggle-panel notice-datetime ;;
      battery|power) run_shell_command toggle-panel notice-battery ;;
      weather) run_shell_command toggle-panel notice-weather ;;
      *) print -u2 'Usage: omacos notice <datetime|battery|weather>'; exit 1 ;;
    esac
    ;;
  default)
    "$installed_root/scripts/defaults.zsh" "${2:-}" "${3:-}" "${4:-}"
    ;;
  launch)
    "$installed_root/scripts/launch.zsh" "${2:-}" "${3:-}"
    ;;
  webapp)
    "$installed_root/scripts/webapps.zsh" "${2:-}" "${3:-}" "${4:-}"
    ;;
  doctor)
    run_doctor
    ;;
  reminder)
    run_reminder_command "${2:-}" "${3:-}" "${4:-}"
    ;;
  theme)
    if [[ ${2:-} != "apply" ]]; then
      print -u2 "Usage: omacos theme apply [name]"
      exit 1
    fi
    "$installed_root/scripts/render-theme.zsh" "${3:-tokyo-night}"
    ;;
  shell)
    run_shell_command "${2:-}" "${3:-}"
    ;;
  uninstall)
    run_uninstall "${2:-}"
    ;;
  help|-h|--help)
    print_usage
    ;;
  *)
    print -u2 "Unknown OMacOS command: ${1:-}"
    print_usage
    exit 1
    ;;
esac
