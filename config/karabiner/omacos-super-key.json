{
  "title": "OMacOS Super key",
  "rules": [
    {
      "description": "Use Right Option as the OMacOS Super layer",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_option",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "omacos_super_key",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "omacos_super_key",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "right_option"
            }
          ]
        },
        {
          "type": "basic",
          "description": "Close window",
          "from": {
            "key_code": "w"
          },
          "conditions": [
            {
              "type": "variable_if",
              "name": "omacos_super_key",
              "value": 1
            }
          ],
          "to": [
            {
              "shell_command": "/bin/zsh -lc '/opt/homebrew/bin/aerospace close'"
            }
          ]
        },
        {
          "type": "basic",
          "description": "Close window",
          "from": {
            "key_code": "q"
          },
          "conditions": [
            {
              "type": "variable_if",
              "name": "omacos_super_key",
              "value": 1
            }
          ],
          "to": [
            {
              "shell_command": "/bin/zsh -lc '/opt/homebrew/bin/aerospace close'"
            }
          ]
        },
        {
          "type": "basic",
          "description": "Terminal",
