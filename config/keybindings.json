{
  "schemaVersion": 1,
  "profile": "right-option",
  "leaderKey": "right_option",
  "globalBindings": [
    {
      "key": "f9",
      "description": "Hold for dictation",
      "keyDownCommand": "$HOME/.local/bin/omacos dictation start",
      "keyUpCommand": "$HOME/.local/bin/omacos dictation stop"
    }
  ],
  "bindings": [
    { "key": "w", "modifiers": [], "description": "Close window", "command": "/opt/homebrew/bin/aerospace close" },
    { "key": "q", "modifiers": [], "description": "Close window", "command": "/opt/homebrew/bin/aerospace close" },
    { "key": "return_or_enter", "modifiers": [], "description": "Terminal", "command": "$HOME/.local/bin/omacos launch terminal" },
    { "key": "return_or_enter", "modifiers": ["shift"], "description": "Browser", "command": "$HOME/.local/bin/omacos launch browser" },
    { "key": "return_or_enter", "modifiers": ["option"], "description": "Tmux", "command": "$HOME/.local/bin/omacos launch tmux" },
    { "key": "f", "modifiers": ["shift"], "description": "File manager", "command": "$HOME/.local/bin/omacos launch files $HOME" },
    { "key": "b", "modifiers": ["shift"], "description": "Browser", "command": "$HOME/.local/bin/omacos launch browser" },
    { "key": "b", "modifiers": ["shift", "option"], "description": "Private browser", "command": "$HOME/.local/bin/omacos launch browser-private" },
    { "key": "n", "modifiers": ["shift"], "description": "Editor", "command": "$HOME/.local/bin/omacos launch editor $HOME" },
    { "key": "spacebar", "modifiers": [], "description": "OMacOS menu", "command": "$HOME/.local/bin/omacos shell toggle-menu" },
    { "key": "escape", "modifiers": [], "description": "System menu", "command": "$HOME/.local/bin/omacos shell toggle-panel system" },
    { "key": "k", "modifiers": [], "description": "Keybindings", "command": "$HOME/.local/bin/omacos shell toggle-panel keybindings" },
    { "key": "v", "modifiers": ["control"], "description": "Clipboard manager", "command": "$HOME/.local/bin/omacos shell toggle-panel clipboard" },
    { "key": "e", "modifiers": ["control"], "description": "Emoji picker", "command": "$HOME/.local/bin/omacos shell toggle-panel emojis" },
    { "key": "c", "modifiers": ["control"], "description": "Capture menu", "command": "$HOME/.local/bin/omacos shell toggle-panel capture" },
    { "key": "r", "modifiers": ["control"], "description": "Set reminder", "command": "$HOME/.local/bin/omacos shell toggle-panel reminders" },
    { "key": "spacebar", "modifiers": ["control"], "description": "Background switcher", "command": "$HOME/.local/bin/omacos shell toggle-panel wallpapers" },
    { "key": "spacebar", "modifiers": ["shift", "control"], "description": "Theme switcher", "command": "$HOME/.local/bin/omacos shell toggle-panel themes" },
    { "key": "a", "modifiers": ["shift", "control"], "description": "Agent usage", "command": "$HOME/.local/bin/omacos shell toggle-panel agents" },
    { "key": "a", "modifiers": ["control"], "description": "Audio panel", "command": "$HOME/.local/bin/omacos shell toggle-panel audio" },
    { "key": "b", "modifiers": ["control"], "description": "Bluetooth panel", "command": "$HOME/.local/bin/omacos shell toggle-panel bluetooth" },
    { "key": "d", "modifiers": ["control"], "description": "Display panel", "command": "$HOME/.local/bin/omacos shell toggle-panel display" },
    { "key": "d", "modifiers": ["control", "option"], "description": "Calendar panel", "command": "$HOME/.local/bin/omacos shell toggle-panel clock" },
    { "key": "w", "modifiers": ["control"], "description": "Network panel", "command": "$HOME/.local/bin/omacos shell toggle-panel network" },
    { "key": "p", "modifiers": ["control"], "description": "Power panel", "command": "$HOME/.local/bin/omacos shell toggle-panel power" },
    { "key": "t", "modifiers": ["control"], "description": "Activity panel", "command": "$HOME/.local/bin/omacos shell toggle-panel activity" },
    { "key": "m", "modifiers": ["control"], "description": "Now playing", "command": "$HOME/.local/bin/omacos shell toggle-panel media" },
    { "key": "o", "modifiers": ["control"], "description": "Weather forecast", "command": "$HOME/.local/bin/omacos shell toggle-panel weather" },
    { "key": "i", "modifiers": ["control"], "description": "Toggle stay awake", "command": "$HOME/.local/bin/omacos toggle toggle idle" },
    { "key": "l", "modifiers": ["control"], "description": "Lock Mac", "command": "$HOME/.local/bin/omacos toggle lock" },
    { "key": "comma", "modifiers": ["control"], "description": "Toggle notification silencing indicator", "command": "$HOME/.local/bin/omacos toggle toggle notification-silencing" },
    { "key": "comma", "modifiers": ["shift", "option"], "description": "Notification history", "command": "$HOME/.local/bin/omacos notification show" },
    { "key": "n", "modifiers": ["control"], "description": "Toggle night light indicator", "command": "$HOME/.local/bin/omacos toggle toggle night-light" },
    { "key": "x", "modifiers": ["control"], "description": "Toggle dictation", "command": "$HOME/.local/bin/omacos dictation toggle" },
    { "key": "spacebar", "modifiers": ["shift"], "description": "Toggle menu bar", "command": "$HOME/.local/bin/omacos toggle toggle bar" },
    { "key": "t", "modifiers": ["control", "option"], "description": "Date and time notice", "command": "$HOME/.local/bin/omacos notice datetime" },
    { "key": "w", "modifiers": ["control", "option"], "description": "Weather notice", "command": "$HOME/.local/bin/omacos notice weather" },
    { "key": "b", "modifiers": ["control", "option"], "description": "Battery notice", "command": "$HOME/.local/bin/omacos notice battery" },
    { "key": "t", "modifiers": [], "description": "Toggle floating and tiling", "command": "/opt/homebrew/bin/aerospace layout floating tiling" },
    { "key": "f", "modifiers": [], "description": "Fullscreen", "command": "/opt/homebrew/bin/aerospace fullscreen" },
    { "key": "j", "modifiers": [], "description": "Toggle window split", "command": "/opt/homebrew/bin/aerospace layout tiles horizontal vertical" },
    { "key": "l", "modifiers": [], "description": "Toggle workspace layout", "command": "/opt/homebrew/bin/aerospace layout tiles accordion" },
    { "key": "s", "modifiers": [], "description": "Toggle scratchpad", "command": "/opt/homebrew/bin/aerospace summon-workspace scratchpad" },
    { "key": "s", "modifiers": ["shift"], "description": "Move window to scratchpad", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace scratchpad" },
    { "key": "tab", "modifiers": [], "description": "Former workspace", "command": "/opt/homebrew/bin/aerospace workspace-back-and-forth" },
    { "key": "tab", "modifiers": ["shift"], "description": "Move workspace to next monitor", "command": "/opt/homebrew/bin/aerospace move-workspace-to-monitor --wrap-around next" },
    { "key": "hyphen", "modifiers": [], "description": "Shrink window", "command": "/opt/homebrew/bin/aerospace resize smart -50" },
    { "key": "equal_sign", "modifiers": [], "description": "Expand window", "command": "/opt/homebrew/bin/aerospace resize smart +50" },
    { "key": "left_arrow", "modifiers": [], "description": "Focus left", "command": "/opt/homebrew/bin/aerospace focus left" },
    { "key": "right_arrow", "modifiers": [], "description": "Focus right", "command": "/opt/homebrew/bin/aerospace focus right" },
    { "key": "up_arrow", "modifiers": [], "description": "Focus up", "command": "/opt/homebrew/bin/aerospace focus up" },
    { "key": "down_arrow", "modifiers": [], "description": "Focus down", "command": "/opt/homebrew/bin/aerospace focus down" },
    { "key": "left_arrow", "modifiers": ["shift"], "description": "Move window left", "command": "/opt/homebrew/bin/aerospace move left" },
    { "key": "right_arrow", "modifiers": ["shift"], "description": "Move window right", "command": "/opt/homebrew/bin/aerospace move right" },
    { "key": "up_arrow", "modifiers": ["shift"], "description": "Move window up", "command": "/opt/homebrew/bin/aerospace move up" },
    { "key": "down_arrow", "modifiers": ["shift"], "description": "Move window down", "command": "/opt/homebrew/bin/aerospace move down" },
    { "key": "left_arrow", "modifiers": ["option"], "description": "Join window left", "command": "/opt/homebrew/bin/aerospace join-with left" },
    { "key": "right_arrow", "modifiers": ["option"], "description": "Join window right", "command": "/opt/homebrew/bin/aerospace join-with right" },
    { "key": "up_arrow", "modifiers": ["option"], "description": "Join window up", "command": "/opt/homebrew/bin/aerospace join-with up" },
    { "key": "down_arrow", "modifiers": ["option"], "description": "Join window down", "command": "/opt/homebrew/bin/aerospace join-with down" },
    { "key": "1", "modifiers": [], "description": "Switch to workspace 1", "command": "/opt/homebrew/bin/aerospace workspace 1" },
    { "key": "2", "modifiers": [], "description": "Switch to workspace 2", "command": "/opt/homebrew/bin/aerospace workspace 2" },
    { "key": "3", "modifiers": [], "description": "Switch to workspace 3", "command": "/opt/homebrew/bin/aerospace workspace 3" },
    { "key": "4", "modifiers": [], "description": "Switch to workspace 4", "command": "/opt/homebrew/bin/aerospace workspace 4" },
    { "key": "5", "modifiers": [], "description": "Switch to workspace 5", "command": "/opt/homebrew/bin/aerospace workspace 5" },
    { "key": "6", "modifiers": [], "description": "Switch to workspace 6", "command": "/opt/homebrew/bin/aerospace workspace 6" },
    { "key": "7", "modifiers": [], "description": "Switch to workspace 7", "command": "/opt/homebrew/bin/aerospace workspace 7" },
    { "key": "8", "modifiers": [], "description": "Switch to workspace 8", "command": "/opt/homebrew/bin/aerospace workspace 8" },
    { "key": "9", "modifiers": [], "description": "Switch to workspace 9", "command": "/opt/homebrew/bin/aerospace workspace 9" },
    { "key": "0", "modifiers": [], "description": "Switch to workspace 10", "command": "/opt/homebrew/bin/aerospace workspace 10" },
    { "key": "1", "modifiers": ["shift"], "description": "Move window to workspace 1", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 1" },
    { "key": "2", "modifiers": ["shift"], "description": "Move window to workspace 2", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 2" },
    { "key": "3", "modifiers": ["shift"], "description": "Move window to workspace 3", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 3" },
    { "key": "4", "modifiers": ["shift"], "description": "Move window to workspace 4", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 4" },
    { "key": "5", "modifiers": ["shift"], "description": "Move window to workspace 5", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 5" },
    { "key": "6", "modifiers": ["shift"], "description": "Move window to workspace 6", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 6" },
    { "key": "7", "modifiers": ["shift"], "description": "Move window to workspace 7", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 7" },
    { "key": "8", "modifiers": ["shift"], "description": "Move window to workspace 8", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 8" },
    { "key": "9", "modifiers": ["shift"], "description": "Move window to workspace 9", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 9" },
    { "key": "0", "modifiers": ["shift"], "description": "Move window to workspace 10", "command": "/opt/homebrew/bin/aerospace move-node-to-workspace 10" }
  ]
}
